test(N) = /* check cardinalities and compatibility of forksubset/forallsubset */
{ my(l1,l2,l3,k);
  l1 = [];
  forsubset(N, s, l1 = concat(l1,s));
  if (#l1 != 2^N, error(N));

  l2 = [];
  for (k = 0, N,
    l3 = [];
    forsubset([N,k], s, l3 = concat(l3,s));
    if (#l3 != binomial(N,k),  error([N,k]));
    l2 = concat(l2, l3);
  );
  if (l1 != l2, error("size ", N));
}
test(0);
test(1);
test(2);
test(3);
test(4);
test(5);

